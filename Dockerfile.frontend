FROM node:22-alpine AS build

WORKDIR /frontend
COPY package.json package-lock.json ./
RUN npm ci

COPY src ./src
COPY web ./web
COPY tsconfig.json ./tsconfig.json
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/web/index.html /usr/share/nginx/html/index.html
COPY --from=build /frontend/web/app.js /usr/share/nginx/html/app.js
COPY --from=build /frontend/web/app.css /usr/share/nginx/html/app.css
COPY --from=build /frontend/web/openapi.json /usr/share/nginx/html/openapi.json

EXPOSE 80
