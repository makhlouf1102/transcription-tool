{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p ../../dist/apps/backend && go build -buildvcs=false -o ../../dist/apps/backend/clearword .",
        "cwd": "apps/backend"
      },
      "outputs": ["{workspaceRoot}/dist/apps/backend"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": ["frontend"]
        }
      ],
      "options": {
        "command": "go run -buildvcs=false .",
        "cwd": "apps/backend",
        "env": {
          "WEB_DIR": "../frontend/web"
        }
      }
    }
  }
}
