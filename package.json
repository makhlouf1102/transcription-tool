{
  "name": "clearword-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript web/openapi.json -o src/api-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:api && npm run typecheck && esbuild src/main.tsx --bundle --minify --outfile=web/app.js"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "openapi-fetch": "0.13.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "esbuild": "^0.25.12",
    "openapi-typescript": "7.6.1",
    "typescript": "5.7.3"
  }
}
